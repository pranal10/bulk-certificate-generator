# Copy to .env (optional - every value has a sensible default).

# Any SQLAlchemy URL. SQLite needs no setup; for Postgres use e.g.
# postgresql+psycopg://user:pass@localhost/certgen (and pip install psycopg).
DATABASE_URL=sqlite:///./data/certgen.db

# Folder where the generated PDFs are stored (one sub-folder per job).
CERTIFICATES_DIR=./data/certificates

# Background threads that render certificates.
WORKER_THREADS=2

# Hard limit on recipients per request.
MAX_RECIPIENTS_PER_JOB=1000

# Printed on every certificate.
ORGANIZATION_NAME=Acme Learning Institute

# Set to true to generate certificates synchronously inside the request
# (handy for debugging; the test-suite uses this).
PROCESS_JOBS_INLINE=false
LOG_LEVEL=INFO
